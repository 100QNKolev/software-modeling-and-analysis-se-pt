table FactSubscriptions
	lineageTag: 0da97e5f-2450-59a6-bdf3-dca158096900

	measure 'Active Subscriptions' = CALCULATE ( COUNTROWS ( FactSubscriptions ), FactSubscriptions[IsActive] = 1 )
		formatString: #,0
		lineageTag: 9922ece7-254f-5316-9183-8e984f304cc5

	measure 'Churn Rate' = DIVIDE ( CALCULATE ( COUNTROWS ( FactSubscriptions ), FactSubscriptions[Status] = "Cancelled" ), COUNTROWS ( FactSubscriptions ) )
		formatString: 0.0%
		lineageTag: 1ae9ca0b-d852-5087-be2c-270a583de06a

