{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.12.0/schema.json",
  "name": "ov_topArtists",
  "position": {
    "x": 980,
    "y": 250,
    "z": 4100,
    "height": 380,
    "width": 900,
    "tabOrder": 4100
  },
  "visual": {
    "visualType": "barChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "DimArtist"
                    }
                  },
                  "Property": "ArtistName"
                }
              },
              "queryRef": "DimArtist.ArtistName",
              "nativeQueryRef": "ArtistName",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "FactStreams"
                    }
                  },
                  "Property": "Total Streams"
                }
              },
              "queryRef": "FactStreams.Total Streams",
              "nativeQueryRef": "Total Streams"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "FactStreams"
                  }
                },
                "Property": "Total Streams"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Streams by artist'"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}