table FactStreams
	lineageTag: b4ae4079-0989-53af-8dac-d7812e02aa2f

	measure 'Total Streams' = COUNTROWS ( FactStreams )
		formatString: #,0
		lineageTag: 4885c3f5-ad38-5cbe-b53f-769aa1f87d76

	measure 'Listening Hours' = DIVIDE ( SUM ( FactStreams[SecondsPlayed] ), 3600 )
		formatString: #,0
		lineageTag: e38c2d0a-1bcb-50fe-93e6-6e67c712f9ab

	measure 'Active Listeners' = DISTINCTCOUNT ( FactStreams[UserKey] )
		formatString: #,0
		lineageTag: 4b7439e2-8561-529b-8297-c6f484b3b070

	measure 'Skip Rate' = DIVIDE ( SUM ( FactStreams[IsSkipped] ), [Total Streams] )
		formatString: 0.0%
		lineageTag: 093cfe30-5a64-576c-bee4-2997768c25ff

